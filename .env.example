# From your Supabase project: Project Settings -> API Keys
# Use the PUBLISHABLE key (sb_publishable_...). It is safe in the browser because
# row-level security protects the data. NEVER put the secret key (sb_secret_...) here:
# anything prefixed VITE_ is bundled into the public JavaScript.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
